{
  "name": "roulette",
  "version": "1.0.0",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "parcel": "^2.16.4",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "lint": "biome check --fix src/",
    "dev": "node scripts/gen-env.js && parcel index.html --port 1235",
    "build": "node scripts/gen-env.js && parcel build index.html --public-url /roulette/ && node scripts/build-sw.js",
    "build:discord": "node scripts/gen-env.js && parcel build index.html --dist-dir dist-discord --public-url /",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "box2d-wasm": "^7.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@swc/core@1.15.18": true,
    "esbuild@0.28.2": true,
    "lmdb@2.8.5": true,
    "msgpackr-extract@3.0.3": true
  }
}
